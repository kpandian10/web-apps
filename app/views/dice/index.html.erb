<h1> Dice Game <h1>
<h3>
<%die1 = rand(1..6)%>
<p>Die 1: <%= die1%><p>

<%die2 = rand(1..6)%>
<p>Die 2: <%=die2%><p>
<p>
  <img src="/images/dice/<%= die1 %>.svg" alt="">
  <img src="/images/dice/<%= die2 %>.svg" alt="">
<p>
<%total = die1 + die2%>
<%= "The total is:" + " " + total.to_s%>
<br>
<h3>

<p> <a href= "/dice"> Roll again! </a> </p>